.PHONY: test cover lint vuln build certs up smoke down
test:   ; go test -race -count=1 ./...
cover:  ; go test -race -coverpkg=./internal/... -coverprofile=coverage.out ./... && go tool cover -func=coverage.out | tail -1
lint:   ; go vet ./... && golangci-lint run ./...
vuln:   ; go run golang.org/x/vuln/cmd/govulncheck@latest ./...
build:  ; CGO_ENABLED=0 go build -trimpath -o bin/ ./cmd/...
certs:  ; go run ./cmd/devca -out certs
up:     ; docker compose up --build -d
smoke:  ; ./scripts/smoke.sh
down:   ; docker compose down -v
